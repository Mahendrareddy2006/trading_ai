# ========================================================
# Trading AI Platform - Environment Configuration Example
# ========================================================

# Operating Mode: "paper" (default, safe) or "live" (requires explicit confirmation)
TRADING_MODE=paper
SAFE_KILL_SWITCH_ACTIVE=false

# Binance API Credentials (OPTIONAL for Paper Trading; only required for Live Trading)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false

# Application & API Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
SECRET_KEY=generate_a_random_32_byte_hex_key_here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Defaults to SQLite for seamless local development)
DATABASE_URL=sqlite:///./trading_ai.db

# Risk Parameters
INITIAL_PAPER_BALANCE=10000.0
MAX_RISK_PER_TRADE=0.01          # 1% equity risk per trade
DEFAULT_LEVERAGE=3                # Max leverage limit
MAX_DAILY_LOSS_PCT=0.02          # 2% daily loss circuit breaker
MAX_DRAWDOWN_PCT=0.10            # 10% maximum trailing drawdown circuit breaker
MAX_CONSECUTIVE_LOSSES=3         # 3 consecutive losses circuit breaker
COOLDOWN_MINUTES=15              # Cooldown period after hitting circuit breaker
MAX_OPEN_POSITIONS=3             # Maximum concurrent open positions

# Machine Learning & Strategy Parameters
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
ENTRY_TIMEFRAME=5m
DIRECTION_TIMEFRAME=1h
REGIME_TIMEFRAME=4h
ML_EDGE_THRESHOLD=0.12           # Minimum probability separation: |P(UP) - P(DOWN)| > 0.12
ML_MIN_PROBABILITY=0.45          # Minimum winner probability to trade
