# ==============================================================================
# Trading AI Platform — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Copy this file to .env: `cp .env.example .env`
# - NEVER commit real credentials, database passwords, or master keys to git.
# - Paper-trading mode is enforced server-level. Live order execution is disabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Runtime
# ------------------------------------------------------------------------------
APP_NAME=TradingAI-Platform
APP_VERSION=2.0.0
ENVIRONMENT=production          # "development", "staging", "production"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Strict Paper Execution Boundary
# ------------------------------------------------------------------------------
TRADING_MODE=paper              # STRICTLY ENFORCED: Real order execution disabled
INITIAL_PAPER_BALANCE=10000.0

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Credential Encryption Keys
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secure_hex_key_minimum_32_bytes

# Fernet / AES-256-GCM Master Key for at-rest user API credential encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=change_this_to_a_valid_fernet_base64_master_key

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Access Control: Explicitly disabled by default for private preview / authorized users
ALLOW_PUBLIC_SIGNUP=false

# Initial Administrator Provisioning (Run `py -m trading_ai.scripts.create_user`)
INITIAL_ADMIN_EMAIL=admin@tradingai.local
INITIAL_ADMIN_PASSWORD=change_this_strong_password_in_production!

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS) Allowlist
# ------------------------------------------------------------------------------
# Comma-separated list of exact allowed frontend origins (NO WILDCARDS WITH CREDENTIALS)
CORS_ORIGINS=https://trading-ai-khaki.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. Database Persistence
# ------------------------------------------------------------------------------
# Local SQLite default:
DATABASE_URL=sqlite:///./trading_ai.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://username:password@db.provider.internal:5432/trading_ai

# ------------------------------------------------------------------------------
# 6. Built-In Public Market Data Provider (Zero Credentials Required)
# ------------------------------------------------------------------------------
# Built-in public market data powered by official Kraken REST & WebSocket v2 APIs.
# Users and servers DO NOT need API keys or secrets to view market data, charts, tickers, or AI signals.
MARKET_DATA_PROVIDER=kraken       # "kraken" (default), "bybit", or "composite"

# ------------------------------------------------------------------------------
# 6b. Optional Private Exchange Account Configuration (Optional Sync Only)
# ------------------------------------------------------------------------------
# Public market data streams require zero credentials.
# Optional read-only credentials may optionally be set to sync private real exchange balances:
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Active Validated Kraken Market Instruments (USDT & USD)
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,LTCUSDT,BCHUSDT,ATOMUSDT,SHIBUSDT,BTCUSD,ETHUSD,SOLUSD,ARBUSD,SUIUSD,NEARUSD

# ------------------------------------------------------------------------------
# 7. Quantitative & Risk Management Parameters
# ------------------------------------------------------------------------------
MAX_RISK_PER_TRADE=0.01          # 1.0% equity risk per trade
DEFAULT_LEVERAGE=3                # Default simulated leverage limit
MAX_DAILY_LOSS_PCT=0.02          # 2.0% daily loss circuit breaker
MAX_DRAWDOWN_PCT=0.10            # 10.0% trailing drawdown circuit breaker
MAX_CONSECUTIVE_LOSSES=3         # 3 consecutive losses threshold
COOLDOWN_MINUTES=120             # 2-hour cooldown upon circuit trip
MAX_OPEN_POSITIONS=4             # Maximum concurrent simulated positions
ML_EDGE_THRESHOLD=0.12           # Minimum probability edge threshold
ML_MIN_PROBABILITY=0.45          # Minimum model winner probability
